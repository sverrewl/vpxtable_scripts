+
+
+  SetupVRRoom
+    If RenderingMode = 2 Or vrtest = 1 Then
+        setup_backglass
+        InitDigits
+        FrameTimer.Enabled = True
+    End If
+	Post.Pullback
+	If Table1.ShowDT = false then
