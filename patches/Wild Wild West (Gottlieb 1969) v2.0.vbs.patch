-    x.AddPt "Polarity", 0, 0, 0
-    x.AddPt "Polarity", 1, 0.05, - 2.7
-    x.AddPt "Polarity", 2, 0.33, - 2.7
-    x.AddPt "Polarity", 3, 0.37, - 2.7
