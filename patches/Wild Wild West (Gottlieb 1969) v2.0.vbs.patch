+Sub MoveArrow
+	Do
+		CurrentOption = CurrentOption + 1
+		If CurrentOption>Len(OptionLinesToMark) Then
+			CurrentOption = 1
+		End If
+	Loop Until Mid(OptionLinesToMark,CurrentOption, 1) = "1"
