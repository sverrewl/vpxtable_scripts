+Sub GateBackStop1_Hit()
+    Dim vx, spd
+    vx  = ActiveBall.VelX
+    spd = Sqr(ActiveBall.VelX * ActiveBall.VelX + ActiveBall.VelY * ActiveBall.VelY)
